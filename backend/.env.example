# Copy to .env and change every value before running anywhere but your laptop.
# In production (APP_ENV=production) SECRET_KEY and FERNET_KEY are required.

# development | production | test
APP_ENV=development

# JWT signing key. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-openssl-rand-hex-32

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=120

# SQLAlchemy URL. A relative SQLite path resolves from backend/.
DATABASE_URL=sqlite:///./data/admissions.db

# 32-byte urlsafe base64 key used to encrypt stored documents. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Seed demo users and applications on startup, but only when the database has
# neither users nor applications. Set true on a fresh deployment.
SEED_ON_START=false

# Upload limits.
MAX_UPLOAD_MB=15

# Where encrypted uploads are stored. Relative paths resolve from backend/.
STORAGE_DIR=./data/uploads

# OCR: tesseract | paddle (paddle is optional and must be installed separately).
OCR_ENGINE=tesseract

# Optional explicit Tesseract binary. Leave blank to search PATH and the usual
# install locations. Not needed in the provided Docker image.
TESSERACT_CMD=

# Comma-separated list of allowed browser origins. Only these origins receive
# CORS headers.
CORS_ORIGINS=http://localhost:5173

# Login rate limiting.
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=300

# Legacy names still accepted for compatibility:
#   FILE_ENCRYPTION_KEY -> FERNET_KEY
#   UPLOAD_DIR          -> STORAGE_DIR
#   FRONTEND_ORIGIN     -> CORS_ORIGINS
