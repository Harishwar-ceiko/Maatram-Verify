# Copy to .env and change every value before running anywhere but your laptop.
APP_ENV=development
SECRET_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=sqlite:///./data/admissions.db

# 32-byte urlsafe base64 key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# Uploads
MAX_UPLOAD_MB=15
UPLOAD_DIR=./data/uploads

# OCR: tesseract | paddle (paddle is optional and must be installed separately)
OCR_ENGINE=tesseract
TESSERACT_CMD=

# CORS for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173

# Login rate limiting
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=300
